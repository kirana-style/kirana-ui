{
  "name": "kirana-ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "vp config",
    "use-kirana": "bun scripts/use-kirana.ts",
    "dev:local": "bun --env-file=.env vp run dev",
    "deps:check": "bun outdated --filter='*'",
    "deps:update": "bun update --recursive",
    "deps:update:latest": "bun update --recursive --latest",
    "deps:update:interactive": "bun update --recursive --interactive",
    "clean": "vp cache clean"
  },
  "devDependencies": {
    "@kirana-style/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "kirana-style": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "trustedDependencies": [
    "esbuild",
    "lightningcss"
  ],
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "registry"
    ],
    "catalog": {
      "@kirana-style/core": "0.3.2",
      "@kirana-style/eslint-plugin": "0.3.2",
      "@kirana-style/preset-scales": "0.3.2",
      "@kirana-style/states": "0.3.2",
      "@kirana-style/vite": "0.3.2",
      "kirana-style": "0.3.2",
      "@ark-ui/vue": "^5.39.3",
      "@base-ui/react": "^1.9.0",
      "@fontsource-variable/geist": "^5.3.0",
      "@fontsource-variable/inter": "^5.3.0",
      "@hugeicons/core-free-icons": "^4.3.5",
      "@tanstack/react-router": "^1.170.45",
      "@tanstack/react-start": "^1.169.3",
      "@types/node": "^26.6.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-vue": "^6.0.10",
      "input-otp": "^1.5.0",
      "lucide": "^1.61.0",
      "react": "^19.3.1",
      "react-aria-components": "^1.22.1",
      "react-day-picker": "^10.0.2",
      "react-dom": "^19.3.1",
      "react-resizable-panels": "^4.14.5",
      "recharts": "^3.10.1",
      "typescript": "^7.0.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
      "vite-plus": "1.3.0",
      "vue": "^3.5.44"
    }
  },
  "overrides": {
    "vite": "catalog:"
  }
}
