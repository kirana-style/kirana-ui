{
  // What `vue-tsc` checks before the build: the app and the registry's Vue markup, which no other
  // check reads (`vp check` reads TypeScript, not single-file components). TypeScript 6, since
  // `vue-tsc` runs on its JavaScript API, which TypeScript 7 does not have.
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "../../registry/bases/vue-ark/**/*.ts",
    "../../registry/bases/vue-ark/**/*.vue"
  ]
}
