{
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    "../../registry/bases/solid-ark/**/*.ts",
    "../../registry/bases/solid-ark/**/*.tsx",
    "../../registry/lib/solid/**/*.ts",
    "../../registry/lib/solid/**/*.tsx",
    "vite.config.ts",
    "kirana.config.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@kirana-style/core/solid"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": { "@workspace/registry/*": ["../../registry/*"] },
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
