{
  // What `svelte-check` checks before the build: the app and the registry's Svelte markup, which no
  // other check reads (`vp check` reads TypeScript, not single-file components). TypeScript 6,
  // since `svelte-check` runs on its JavaScript API, which TypeScript 7 does not have.
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "../../registry/bases/svelte-ark/**/*.ts",
    "../../registry/bases/svelte-ark/**/*.svelte",
    "../../registry/bases/svelte-bits/**/*.ts",
    "../../registry/bases/svelte-bits/**/*.svelte",
    "../../registry/icons/IconPlaceholder.svelte",
    "../../registry/lib/svelte/**/*.ts",
    "../../registry/lib/svelte/**/*.svelte"
  ]
}
