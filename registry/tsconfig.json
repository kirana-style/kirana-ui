{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["."],
  // Solid's and Angular's markup type-checks in its preview app (`apps/preview-solid`,
  // `apps/preview-angular`), with that framework's JSX and decorators.
  "exclude": [
    "node_modules",
    "dist",
    ".flat",
    "bases/solid-ark",
    "bases/angular-ng"
  ]
}
