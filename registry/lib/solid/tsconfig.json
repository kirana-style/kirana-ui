{
  // Solid's helpers type-check with Solid's JSX, as its markup does in `apps/preview-solid`.
  "extends": "../../tsconfig.json",
  "include": ["."],
  "exclude": [],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client", "@kirana-style/core/solid"]
  }
}
